# Postgres for the app, in every environment. Neon, branch `production`.
#
# Required, no default: a fallback would mean running against the wrong
# database rather than failing. Keep sslmode=verify-full: `require` encrypts
# but authenticates nothing, so it stops eavesdropping and not impersonation.
DATABASE_URL=

# Postgres for the TEST SUITE and nothing else. Neon, branch `tests`.
#
# Deliberately a different variable, and deliberately a different branch. The
# suite truncates every table between tests, so this must point at a database
# that is disposable on purpose. The suite refuses to start if it is the same
# as DATABASE_URL.
TEST_DATABASE_URL=

# Salt for hashing caller IP addresses.
#
# REQUIRED in production. An unsalted SHA-256 of an IPv4 address is reversible
# by brute force — four billion preimages — so the stored hashes would be
# visitor IP addresses in all but name. Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=

# Secret that signs the painter cookie.
#
# REQUIRED in production, no default. Without it anyone can mint a painter
# identity per pixel and the cooldown means nothing.
# Generate with: openssl rand -hex 32
PAINTER_COOKIE_SECRET=

# Allow requests with no trustworthy client address. Local development only —
# it must stay unset in production, where no client address means no rate
# limiting at all.
# ALLOW_UNTRUSTED_CLIENT_IP=true

# How many proxies sit in front of this app and append to x-forwarded-for.
# Default 1, which matches Vercel.
# TRUSTED_PROXY_HOPS=1

# Which inbound header, if any, this deployment's edge overwrites with the
# caller's real address — and therefore the only header we trust ahead of
# x-forwarded-for. Unset means trust nothing but our own proxy chain: every
# other candidate header is an ordinary inbound header a caller can set to
# anything, including someone else's rate-limit bucket. On Vercel, the
# deployment target, set this to x-vercel-forwarded-for.
# TRUSTED_PLATFORM_HEADER=x-vercel-forwarded-for

# The wallet that receives entry payments, as a Solana address.
#
# REQUIRED in production, no default: a fallback here would mean a
# misconfigured deploy quietly collects payments to somebody else's address.
# This project only ever receives — it holds no private key for this wallet
# and never signs with it.
PAYMENT_WALLET=

# Solana RPC endpoint(s) used to verify payments, comma-separated and tried in
# order. Deliberately the public mainnet endpoint by default: no provider SDK,
# no other endpoint hardcoded. Put a paid provider here to move off the public
# node without a code change; it is heavily rate limited and does not always
# serve historical transactions.
#
# The HOSTNAME here decides whether this deployment takes payments at all.
# `classifyEndpoint` in src/lib/payments/cluster.ts reads the cluster out of
# the host and path — never the query string, which is where a provider's key
# lives — and a URL it cannot classify answers `unknown`, which BLOCKS every
# payment rather than guessing mainnet. So a provider URL that names its
# cluster works and one that does not is refused:
#
#   https://mainnet.helius-rpc.com/?api-key=...   -> solana:mainnet, pays
#   https://rpc.helius.xyz/?api-key=...           -> unknown, blocks
#
# Same provider, same key, same cluster. Only the host differs. Refusing is
# the deliberate half of that: a payer who cannot pay asks, a payer who paid
# on the wrong chain does not know to.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Shared secret that authenticates the reconcile cron endpoint,
# POST /api/cron/reconcile, sent in the x-cron-secret header.
#
# REQUIRED in production, no default. The endpoint FAILS CLOSED: with this
# unset it refuses every request with a 503 rather than running unguarded.
# That is the point — the pass it triggers spends calls on the same
# rate-limited RPC endpoint every live checkout uses, so an unauthenticated
# version of it is a way for anyone who finds the path to take that quota
# away from paying users on demand.
#
# Must match the CRON_SECRET repository secret that
# .github/workflows/reconcile.yml sends. Generate with: openssl rand -hex 32
CRON_SECRET=

# The admin token. One operator, one secret, typed into the sign-in form at
# /admin.
#
# REQUIRED for /admin to exist at all, and there is no default. The admin
# surface FAILS CLOSED: with this unset it refuses every request, including
# one carrying what would have been the right token, and including a browser
# still holding a session cookie from when it was set. Unset never means open.
#
# What goes in the cookie is a session id, never this value, so the secret is
# never handled again after sign-in.
#
# If a cookie leaks, CLEAR this variable. That is the whole of the remedy this
# product has: it kills every live session along with the surface. Rotating it
# to a new value does NOT kill them — a session row stores a label, never the
# secret — and there is no screen or script that revokes somebody else's
# session. Signing out revokes your own and only your own.
#
# Five wrong guesses from one caller buys a fifteen-minute lockout, so a short
# hand-typed value is not as safe as it looks. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Where a payer whose transfer did not match an order is told to go. A human
# queue, not an automated one — the copy on that page says so.
#
# This address is the decision, not an example: it is what every "your payment
# has been filed for support" message tells a payer to write to, and the queue
# behind it is /admin/orphans. Unset is allowed and is honest about itself —
# `filedClause` in src/lib/payments/settle.ts then tells the payer this
# deployment has no contact configured rather than naming one that bounces —
# but a deployment taking real money should set it.
SUPPORT_CONTACT=support@pixelwar.fun

# The public origin of this deployment, e.g. https://pixelwar.fun
#
# The source of truth for the same-origin check on painting. Set it in
# production and previews, where the Host header need not match the public
# hostname; a malformed value falls back to Host rather than failing every
# paint. Unset is fine locally, where Host is the origin.
# SITE_URL=https://pixelwar.fun

# --- Tuning. Every one of these has a working default; set them only to move
# --- off it. Listed so a deploy can find them without reading the source.

# Postgres pool size. Default 10.
# DATABASE_POOL_MAX=10

# Most pixel changes one /api/diff response will carry before the client is
# told to re-fetch the whole canvas instead. Default 8000.
# DIFF_MAX_CHANGES=8000

# Order creation per ip_hash. Defaults: 8 orders per 10 minutes.
# ORDER_RATE_LIMIT_MAX=8
# ORDER_RATE_LIMIT_WINDOW_MINUTES=10

# Token metadata lookups per ip_hash. Defaults: 30 per 60 seconds.
# TOKEN_RATE_LIMIT_MAX=30
# TOKEN_RATE_LIMIT_WINDOW_SECONDS=60

# Calls through the RPC proxy per ip_hash. Defaults: 120 per 60 seconds.
#
# This one is shared between every payer's live checkout and any recovery
# pass, so raising it and raising the provider's own quota are the same
# decision. Too low and a checkout fails; too high and one visitor can spend
# the quota the rest of them need.
# RPC_RATE_LIMIT_MAX=120
# RPC_RATE_LIMIT_WINDOW_SECONDS=60

# Painting burst per /24 (IPv4) or /48 (IPv6), on top of the per-painter
# cooldown. Defaults: 60 paints per 60 seconds.
# PAINT_SUBNET_BURST=60
# PAINT_SUBNET_WINDOW_SECONDS=60

# The last window: minutes before a war ends in which nobody NEW may pick a
# side. Painters who already have one are untouched. Default 0 — NO LOCK —
# and that is the decision, not a placeholder: whether a war closes its sides
# is a rule about what winning means, and it is the owner's to make. A
# garbage value reads as 0 rather than as some lock.
#
# It can only ever turn a paint into a refusal, so it cannot raise the paint
# rate, and it refuses above the `last_seq` lock so it does not queue behind
# the ~40/s ceiling either. See docs/operations.md.
# PAINT_SIDES_LOCK_MINUTES=0

# When the board is busy enough to be worth a human look. NOT a brake: nothing
# pauses, bans or slows on these — a raid and an attack are the same shape, so
# an automatic response would fire on the case this product exists to cause.
# See docs/operations.md.
#
# These are GUESSES until a real war produces real numbers, which is why they
# are variables: correcting them costs a variable change, not a deploy.
# ABUSE_WINDOW_MINUTES=10
# ABUSE_RATE_PER_MINUTE=120
# ABUSE_CELL_PAINTS=60

# What registering to paint costs, in SOL. Default 0.003.
#
# ZERO IS A VALID VALUE AND IT IS THE DOOR: `REGISTRATION_FEE_SOL=0` turns
# registration into a wallet signature with no payment, in a variable, with no
# deploy. It exists so a launch that shows the fee is killing the volume can
# stop charging in a minute. A wallet is still required either way, so the
# paint path is the same code at any price.
#
# DENOMINATED IN SOL AND NOT IN DOLLARS, deliberately. A dollar price charged
# in SOL needs a live SOL/USD feed in the money path — its own outage, its own
# staleness window, its own manipulation surface — to collect the equivalent
# of fifty cents. The USDC checkout dodges that by using a dollar-pegged
# token; this path cannot, so it does not pretend to. When SOL moves far
# enough to matter, move this number.
#
# It is paid to PAYMENT_WALLET, the same address entry payments go to. Never
# call it a network fee anywhere: Solana's own fee on the transfer is under a
# thousandth of a cent, and this one is ours.
#
# A malformed value falls back to the default rather than to zero — a typo
# that silently switches the fee off costs money quietly, and one that
# silently raises it is worse.
# REGISTRATION_FEE_SOL=0.003

# Signature challenges one caller may take per ip_hash, and the window.
# Defaults: 20 per 10 minutes, shared across the oath and the browser link —
# both write into the same table, so one budget is what is actually true.
#
# Issuing a challenge writes a row and spends no RPC call, which is why this
# is its own limit and not part of the payment verifier's: a wallet asking to
# sign must not be able to exhaust the allowance a payer needs to confirm
# money.
# NONCE_RATE_LIMIT_MAX=20
# NONCE_RATE_LIMIT_WINDOW_MINUTES=10

# Pre-flight checks one wallet may make per minute. Default 5.
#
# Its own limit, deliberately not the payment verifier's: the retry this
# endpoint exists to cause — "you need more SOL" → fund the wallet → come
# back — is exactly what the verifier's three-second floor and its
# ten-per-ten-minutes cap would refuse. There is no minimum gap here at all.
# PREFLIGHT_RATE_LIMIT_MAX=5
